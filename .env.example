# Quantum Agent V2.1
#
# Copy this file to `.env` for Docker Compose, keep the real file mode 0600,
# replace every blank secret, and update the direct DATABASE_URL placeholder if
# that launch mode is used. Never expose these values through NEXT_PUBLIC_*
# variables or browser responses.

# Compose topology
POSTGRES_DB=quantum_agent
POSTGRES_USER=quantum_agent
POSTGRES_PASSWORD=
# Percent-encoded form of POSTGRES_PASSWORD for the async SQLAlchemy URL.
POSTGRES_PASSWORD_URLENCODED=
NEO4J_PASSWORD=
REDIS_PASSWORD=
API_ENVIRONMENT=development
API_FORWARDED_ALLOW_IPS=127.0.0.1
API_PORT=8000
WEB_PORT=3000
QA_IMAGE_TAG=local
GRAPH_SYNC_BATCH_SIZE=100
GRAPH_SYNC_POLL_SECONDS=2
# Set to 1 only when the live-infrastructure test must assert the published corpus.
QA_LIVE_REQUIRE_CORPUS=0

# Python FastAPI backend: USTC gateway and server-only model registry
USTC_API=
USTC_BASE_URL=https://api.llm.ustc.edu.cn/v1
USTC_MODEL=deepseek-v4-pro
USTC_MODEL_QUICK=deepseek-v4-flash-ascend1
USTC_VISION_MODEL=qwen3.8-chat
USTC_MODEL_VISION_REASONER=qwen3.8-reasoner
USTC_MODEL_CODE=glm-5.2
USTC_MODEL_EMBEDDING=qwen3-embedding
USTC_MODEL_RERANK=qwen3-reranker
USTC_MODEL_MINERU=mineru
USTC_MODEL_OCR=unlimited-ocr

# Python embedding gateway. `local_hashing` is deterministic degraded retrieval,
# not a learned semantic model. `openai_compatible` requires all three values.
EMBEDDING_PROVIDER=local_hashing
EMBEDDING_DIMENSION=384
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Direct Python process settings. Compose constructs DATABASE_URL internally and
# maps API_ENVIRONMENT to ENVIRONMENT for its API and migration containers.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://quantum_agent:replace-me@localhost:5432/quantum_agent
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Student uploads. Compose overrides ATTACHMENT_STORAGE_ROOT with its persistent,
# backend-only attachment_data volume. Archive limits protect DOCX/PPTX ZIP input.
ATTACHMENT_STORAGE_ROOT=var/attachments
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_MAX_IMAGE_PIXELS=40000000
ATTACHMENT_MAX_IMAGE_DIMENSION=16384
ATTACHMENT_MAX_DOCUMENT_PAGES=500
ATTACHMENT_MAX_ARCHIVE_ENTRIES=5000
ATTACHMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000
ATTACHMENT_MAX_ARCHIVE_COMPRESSION_RATIO=100

# Server-side Next.js BFF connection. This URL is never a student-selectable route.
QUANTUM_API_BASE_URL=http://127.0.0.1:8000

# Still-supported legacy web routes only; these are not used by `/agent`,
# `/teacher/traces`, or the authoritative Python teaching workflow.
TEACHER_PASSWORD=
SESSION_SECRET=
SANDBOX_BASE_URL=
SANDBOX_API_KEY=
