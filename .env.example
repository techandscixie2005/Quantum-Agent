# USTC OpenAI-compatible gateway
USTC_API_KEY=
USTC_BASE_URL=https://api.llm.ustc.edu.cn
USTC_MODEL_QUICK=deepseek-v4-flash-ascend1
USTC_MODEL_DEEP=deepseek-v4-pro
USTC_MODEL_VISION=qwen3.6-chat
USTC_MODEL_VISION_REASONER=qwen3.6-reasoner
USTC_MODEL_CODE=glm-5.2
MODEL_TIMEOUT_MS=60000

# Optional: override one or more routes without changing source code.
# Keep this JSON on one line in real environment files.
# MODEL_ROUTES_JSON={"quick":{"provider":"ustc","model":"deepseek-v4-flash-ascend1"},"code":{"provider":"ustc","model":"glm-5.2"}}

# Optional external, OpenAI-compatible isolated Python execution service.
SANDBOX_BASE_URL=
SANDBOX_API_KEY=

# Teacher dashboard password (server-side secret; required for teacher analytics access).
TEACHER_PASSWORD=

# Optional: separate signing key for teacher session tokens.
# When unset, TEACHER_PASSWORD is also used as the session signing material.
SESSION_SECRET=
